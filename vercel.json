{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/",
      "destination": "/dist/index.html"
    },
    {
      "source": "/admin",
      "destination": "/dist/admin.html"
    },
    {
      "source": "/admin.html",
      "destination": "/dist/admin.html"
    },
    {
      "source": "/styles.css",
      "destination": "/dist/styles.css"
    },
    {
      "source": "/admin.css",
      "destination": "/dist/admin.css"
    },
    {
      "source": "/admin.js",
      "destination": "/dist/admin.js"
    },
    {
      "source": "/admin-auth.js",
      "destination": "/dist/admin-auth.js"
    },
    {
      "source": "/app.js",
      "destination": "/dist/app.js"
    },
    {
      "source": "/banners.js",
      "destination": "/dist/banners.js"
    },
    {
      "source": "/carousel.js",
      "destination": "/dist/carousel.js"
    },
    {
      "source": "/store-config.js",
      "destination": "/dist/store-config.js"
    },
    {
      "source": "/store-data.js",
      "destination": "/dist/store-data.js"
    },
    {
      "source": "/assets/:path*",
      "destination": "/dist/assets/:path*"
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0, must-revalidate"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/(.*\\.js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*\\.css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
