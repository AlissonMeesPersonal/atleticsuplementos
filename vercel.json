{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/",
      "destination": "/dist/index.html"
    },
    {
      "source": "/admin",
      "destination": "/dist/admin.html"
    },
    {
      "source": "/admin.html",
      "destination": "/dist/admin.html"
    },
    {
      "source": "/styles.css",
      "destination": "/dist/styles.css"
    },
    {
      "source": "/admin.css",
      "destination": "/dist/admin.css"
    },
    {
      "source": "/admin.js",
      "destination": "/dist/admin.js"
    },
    {
      "source": "/admin-auth.js",
      "destination": "/dist/admin-auth.js"
    },
    {
      "source": "/app.js",
      "destination": "/dist/app.js"
    },
    {
      "source": "/banners.js",
      "destination": "/dist/banners.js"
    },
    {
      "source": "/carousel.js",
      "destination": "/dist/carousel.js"
    },
    {
      "source": "/store-config.js",
      "destination": "/dist/store-config.js"
    },
    {
      "source": "/store-data.js",
      "destination": "/dist/store-data.js"
    },
    {
      "source": "/assets/:path*",
      "destination": "/dist/assets/:path*"
    },
    {
      "source": "/purchase-flow.js",
      "destination": "/dist/purchase-flow.js"
    },
    {
      "source": "/purchase-flow.css",
      "destination": "/dist/purchase-flow.css"
    },
    {
      "source": "/customer-account.js",
      "destination": "/dist/customer-account.js"
    },
    {
      "source": "/customer-account.css",
      "destination": "/dist/customer-account.css"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://viacep.com.br; media-src 'self' blob:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0, must-revalidate"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/(.*\\.js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*\\.css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
